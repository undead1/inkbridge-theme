{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#0F172A",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#4F46E5",
					"name": "Accent 1",
					"slug": "accent-1"
				},
				{
					"color": "#06B6D4",
					"name": "Accent 2",
					"slug": "accent-2"
				},
				{
					"color": "#F8FAFC",
					"name": "Accent 3",
					"slug": "accent-3"
				},
				{
					"color": "#64748B",
					"name": "Accent 4",
					"slug": "accent-4"
				},
				{
					"color": "#1E293B",
					"name": "Accent 5",
					"slug": "accent-5"
				},
				{
					"color": "#E2E8F0",
					"name": "Accent 6",
					"slug": "accent-6"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "3XS", "size": "4px", "slug": "10" },
				{ "name": "2XS", "size": "8px", "slug": "20" },
				{ "name": "XS", "size": "16px", "slug": "30" },
				{ "name": "S", "size": "24px", "slug": "40" },
				{ "name": "M", "size": "clamp(24px, 4vw, 40px)", "slug": "50" },
				{ "name": "L", "size": "clamp(32px, 6vw, 64px)", "slug": "60" },
				{ "name": "XL", "size": "clamp(48px, 8vw, 96px)", "slug": "70" },
				{ "name": "2XL", "size": "clamp(64px, 10vw, 128px)", "slug": "80" }
			],
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"name": "Body",
					"slug": "body"
				},
				{
					"fontFamily": "ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace",
					"name": "Mono",
					"slug": "mono"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					},
					"name": "Medium",
					"size": "1.125rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					},
					"name": "Large",
					"size": "1.375rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "1.5rem",
						"max": "2rem"
					},
					"name": "Extra Large",
					"size": "2rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"min": "2rem",
						"max": "3rem"
					},
					"name": "2X Large",
					"size": "3rem",
					"slug": "xx-large"
				},
				{
					"fluid": {
						"min": "2.5rem",
						"max": "4rem"
					},
					"name": "3X Large",
					"size": "4rem",
					"slug": "xxx-large"
				}
			],
			"writingMode": true
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.2",
					"letterSpacing": "-0.02em"
				},
				"spacing": {
					"margin": {
						"top": "1.5em",
						"bottom": "0.5em"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xxx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "600"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.1em"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent-1",
					"text": "#FFFFFF"
				},
				":hover": {
					"color": {
						"background": "#4338CA"
					}
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "2rem",
						"right": "2rem"
					}
				},
				"border": {
					"radius": "8px"
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent-1"
				},
				":hover": {
					"color": {
						"text": "#4338CA"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				"typography": {
					"textDecoration": "none"
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.5"
				},
				"color": {
					"text": "var:preset|color|accent-4"
				}
			}
		},
		"blocks": {
			"core/code": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400",
					"lineHeight": "1.7"
				},
				"color": {
					"background": "var:preset|color|accent-3",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40"
					}
				},
				"border": {
					"radius": "8px",
					"color": "var:preset|color|accent-6",
					"width": "1px",
					"style": "solid"
				}
			},
			"core/quote": {
				"border": {
					"width": "0 0 0 4px",
					"color": "var:preset|color|accent-1",
					"style": "solid"
				},
				"color": {
					"background": "var:preset|color|accent-3"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"right": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/list": {
				"typography": {
					"lineHeight": "1.7"
				}
			},
			"core/separator": {
				"border": {
					"color": "var:preset|color|accent-6",
					"style": "solid",
					"width": "0 0 1px 0"
				}
			},
			"core/image": {
				"border": {
					"radius": "8px"
				}
			},
			"core/preformatted": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.7"
				},
				"color": {
					"background": "var:preset|color|accent-3"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40"
					}
				},
				"border": {
					"radius": "8px"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "400"
				},
				"border": {
					"color": "var:preset|color|accent-1",
					"style": "solid",
					"width": "2px 0"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40"
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent-1"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent-1"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent-1"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
